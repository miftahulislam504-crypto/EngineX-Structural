# CivilOS Structural — Environment Variables
#
# এই ফাইলটা টেমপ্লেট। আসল মান দিয়ে `.env.local` বানান (লোকাল ডেভের জন্য)
# এবং Vercel Project Settings → Environment Variables এ একই key-value
# গুলা বসান (production/preview এর জন্য)।
#
# .env.local কখনো git-এ কমিট হবে না (.gitignore এ আছে)।

# --- Firebase (Hub এর সাথে শেয়ার করা একই project) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Compute Microservice (originally planned for Cloud Run; ---
# --- currently hosted on Railway to avoid GCP's card requirement) ---
# civilos-structural-solver ডিপ্লয় করার পর যে URL পাবেন (Railway অথবা
# Cloud Run, যেটাই ব্যবহার করছেন) সেটা এখানে বসান, উদাহরণ:
# https://civilos-structural-solver-production.up.railway.app
NEXT_PUBLIC_COMPUTE_SERVICE_URL=
